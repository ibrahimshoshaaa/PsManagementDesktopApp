# Generated code (drift) — بيتولد من dart run build_runner build
# لو عايز تسيبه متتبّع في الريبو عادي (بيوفر خطوة build_runner لأي حد بيعمل clone)،
# امسح السطر ده. الأفضل عمومًا إنه يتولد في CI زي باقي مشاريعك.
**/*.g.dart

# Windows
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake

# IDE
.vscode/
.idea/

# Local DB file (بيتولد وقت التشغيل، مش المفروض يتتبّع)
*.sqlite
*.sqlite-journal
